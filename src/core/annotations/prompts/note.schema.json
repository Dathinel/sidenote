{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "sections",
    "figures",
    "open_questions",
    "todos"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "paragraphs",
          "figure_refs"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "figure_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "figure_id",
          "capture_id",
          "caption",
          "callouts",
          "app",
          "window_title",
          "keyframe_index",
          "keyframe_reason"
        ],
        "properties": {
          "figure_id": {
            "type": "string"
          },
          "capture_id": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "callouts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mark_id",
                "label",
                "explanation",
                "evidence_refs",
                "uncertainty",
                "mark_number",
                "boxNorm",
                "description"
              ],
              "properties": {
                "mark_id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "uncertainty": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mark_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "boxNorm": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "app": {
            "type": "string"
          },
          "window_title": {
            "type": "string"
          },
          "keyframe_index": {
            "type": "integer",
            "minimum": 0
          },
          "keyframe_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "owner",
          "due_date",
          "evidence_refs"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "title": "Annotation note"
}
