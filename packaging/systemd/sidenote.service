[Unit]
Description=Sidenote background server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/sidenote --server --device-role server
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
MemoryMax=1G
CPUQuota=100%
TasksMax=64
UMask=0077
NoNewPrivileges=yes
LimitCORE=0

[Install]
WantedBy=default.target
