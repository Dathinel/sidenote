[Unit]
Description=Decrypt Sidenote credential for %i
Before=systemd-user-sessions.service

[Service]
Type=simple
User=%i
LoadCredentialEncrypted=sidenote-key:/etc/credstore.encrypted/sidenote-%i
ExecStart=/usr/bin/sleep infinity
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
MemoryMax=16M

[Install]
WantedBy=multi-user.target
